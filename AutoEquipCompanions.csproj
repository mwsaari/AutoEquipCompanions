    <!-- Linux/mono dev-only: lets MSBuild find .NETFramework v4.8 reference assemblies where no
         Windows targeting pack is installed (e.g. Rider or `dotnet build` on Linux). Checks both
         the plain host path and the Flatpak-sandboxed path (Flatpak keeps /usr as the runtime's
         own, remapping the real host /usr under /run/host/usr, even with full host filesystem
         access granted) so it resolves whether MSBuild runs directly on the host or inside
         Rider's Flatpak sandbox. No-op on Windows/Visual Studio since neither path exists there. -->
    <PropertyGroup>
        <MonoFrameworkPath Condition="Exists('/usr/lib/mono/4.8-api')">/usr/lib/mono/4.8-api</MonoFrameworkPath>
        <MonoFrameworkPath Condition="'$(MonoFrameworkPath)' == '' and Exists('/run/host/usr/lib/mono/4.8-api')">/run/host/usr/lib/mono/4.8-api</MonoFrameworkPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MonoFrameworkPath)' != ''">
        <FrameworkPathOverride>$(MonoFrameworkPath)</FrameworkPathOverride>
    </PropertyGroup>
